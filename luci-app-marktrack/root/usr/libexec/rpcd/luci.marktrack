#!/bin/sh
# Mark and Track — LuCI rpcd backend (connections)
# Parses /proc/net/nf_conntrack and returns per-connection data with DSCP labels.
# Pure shell + awk: no lua / luci-lib-jsonc dependency (works on apk-based 24.10+).
#
# rpcd exec-plugin protocol:
#   luci.marktrack list                     -> JSON describing methods
#   luci.marktrack call getConntrackDSCP    -> JSON connection data on stdout

CONNTRACK_FILE=/proc/net/nf_conntrack

get_max_connections() {
    local m
    m=$(uci -q get marktrack.settings.MAX_CONNECTIONS 2>/dev/null)
    case "$m" in
        ''|*[!0-9]*) printf '0' ;;
        *)           printf '%s' "$m" ;;
    esac
}

get_conntrack_dscp() {
    local max
    max=$(get_max_connections)

    if [ ! -r "$CONNTRACK_FILE" ]; then
        printf '{"connections":{},"max_connections":0,"error":"cannot read %s"}\n' "$CONNTRACK_FILE"
        return 0
    fi

    awk -v max="$max" '
        BEGIN {
            split("0:CS0 8:CS1 10:AF11 12:AF12 14:AF13 16:CS2 18:AF21 20:AF22 22:AF23 " \
                  "24:CS3 26:AF31 28:AF32 30:AF33 32:CS4 34:AF41 36:AF42 38:AF43 " \
                  "40:CS5 46:EF 48:CS6 56:CS7", _m, " ")
            for (i in _m) { split(_m[i], kv, ":"); lbl[kv[1]] = kv[2] }
            printf "{\"connections\":{"
            first = 1
            count = 0
        }
        {
            if (max > 0 && count >= max) next

            layer3  = $1
            proto   = $3
            timeout = $5
            if (proto == "") next

            s1=""; d1=""; sp1=""; dp1=""; p1="0"; b1="0"
            s2=""; d2=""; sp2=""; dp2=""; p2="0"; b2="0"
            mark = 0
            nsrc=0; ndst=0; nsp=0; ndp=0; npk=0; nby=0

            for (i = 1; i <= NF; i++) {
                t = $i
                if (substr(t,1,4) == "src=")         { v=substr(t,5);  nsrc++; if(nsrc==1)s1=v;  else if(nsrc==2)s2=v }
                else if (substr(t,1,4) == "dst=")    { v=substr(t,5);  ndst++; if(ndst==1)d1=v;  else if(ndst==2)d2=v }
                else if (substr(t,1,6) == "sport=")  { v=substr(t,7);  nsp++;  if(nsp==1)sp1=v;  else if(nsp==2)sp2=v }
                else if (substr(t,1,6) == "dport=")  { v=substr(t,7);  ndp++;  if(ndp==1)dp1=v;  else if(ndp==2)dp2=v }
                else if (substr(t,1,8) == "packets="){ v=substr(t,9);  npk++;  if(npk==1)p1=v;   else if(npk==2)p2=v }
                else if (substr(t,1,6) == "bytes=")  { v=substr(t,7);  nby++;  if(nby==1)b1=v;   else if(nby==2)b2=v }
                else if (substr(t,1,5) == "mark=")   { mark=substr(t,6)+0 }
            }

            if (s1 == "") next
            if (proto == "icmp" || proto == "icmpv6") { sp1="-"; dp1="-" }
            if (sp1 == "") sp1="-"
            if (dp1 == "") dp1="-"

            dscp = mark % 64
            dl = (dscp in lbl) ? lbl[dscp] : (dscp "")

            key = proto "_" s1 "_" sp1 "_" d1 "_" dp1

            if (!first) printf ","
            first = 0

            printf "\"%s\":{", key
            printf "\"layer3\":\"%s\",", layer3
            printf "\"protocol\":\"%s\",", proto
            printf "\"src\":\"%s\",\"dst\":\"%s\",", s1, d1
            printf "\"sport\":\"%s\",\"dport\":\"%s\",", sp1, dp1
            printf "\"in_bytes\":%s,\"out_bytes\":%s,", (b1==""?"0":b1), (b2==""?"0":b2)
            printf "\"in_packets\":%s,\"out_packets\":%s,", (p1==""?"0":p1), (p2==""?"0":p2)
            printf "\"bytes\":%.0f,\"packets\":%.0f,", (b1+0)+(b2+0), (p1+0)+(p2+0)
            printf "\"timeout\":%d,\"mark\":%d,", timeout+0, mark
            printf "\"dscp\":%d,\"dscp_label\":\"%s\"", dscp, dl
            printf "}"

            count++
        }
        END {
            printf "},\"max_connections\":%d}\n", max
        }
    ' "$CONNTRACK_FILE"
}

case "$1" in
    list)
        printf '{"getConntrackDSCP":{}}\n'
        ;;
    call)
        case "$2" in
            getConntrackDSCP) get_conntrack_dscp ;;
            *)                printf '{"error":"unknown method"}\n' ;;
        esac
        ;;
    *)
        printf '{"error":"usage: %s {list|call <method>}"}\n' "$0"
        ;;
esac
