#!/usr/bin/env lua

-- Mark and Track — LuCI rpcd backend
-- Reads /proc/net/nf_conntrack and exposes connection data with DSCP labels.
-- Called by the LuCI connections.js page via ubus.
--
-- Implements the standard rpcd exec-plugin protocol:
--   <script> list                 -> prints JSON describing available methods
--   <script> call <method>        -> reads JSON params on stdin, prints JSON result

local jsonc = require "luci.jsonc"

-- Decode a numeric DSCP value to a human-readable label
local function dscp_to_label(dscp)
    local map = {
        [0]  = "CS0",  [8]  = "CS1",
        [10] = "AF11", [12] = "AF12", [14] = "AF13",
        [16] = "CS2",  [18] = "AF21", [20] = "AF22", [22] = "AF23",
        [24] = "CS3",  [26] = "AF31", [28] = "AF32", [30] = "AF33",
        [32] = "CS4",  [34] = "AF41", [36] = "AF42", [38] = "AF43",
        [40] = "CS5",  [46] = "EF",
        [48] = "CS6",  [56] = "CS7"
    }
    return map[dscp] or tostring(dscp)
end

-- Parse one line from /proc/net/nf_conntrack
-- Returns a table or nil on failure
local function parse_connection(line)
    local conn = {}

    -- conntrack line prefix: <l3name> <l3num> <l4name> <l4num> <timeout_seconds> [state] ...
    -- e.g. "ipv4 2 tcp 6 431999 ESTABLISHED src=..."
    conn.layer3, conn.layer4, conn.protocol, conn.l4proto, conn.timeout =
        line:match("(%w+)%s+(%d+)%s+(%w+)%s+(%d+)%s+(%d+)")
    if not (conn.layer3 and conn.protocol and conn.timeout) then
        return nil
    end

    if conn.protocol == "icmp" or conn.protocol == "icmpv6" then
        -- ICMP: no ports; two directions (request + reply) like TCP/UDP
        local src1, dst1, pkts1, bytes1, src2, dst2, pkts2, bytes2 =
            line:match(
                "src=(%S+)%s+dst=(%S+)%s+%S+%s+%S+%s+%S+%s+packets=(%d+)%s+bytes=(%d+)"
                .. "%s+src=(%S+)%s+dst=(%S+)%s+%S+%s+%S+%s+%S+%s+packets=(%d+)%s+bytes=(%d+)"
            )
        conn.src   = src1 or line:match("src=(%S+)") or "?"
        conn.dst   = dst1 or "?"
        conn.sport = "-"
        conn.dport = "-"
        conn.in_packets  = pkts1 or "0"
        conn.in_bytes    = bytes1 or "0"
        conn.out_packets = pkts2 or "0"
        conn.out_bytes   = bytes2 or "0"
    else
        -- TCP/UDP: two directions (original + reply)
        local src1, dst1, sport1, dport1, pkts1, bytes1,
              src2, dst2, sport2, dport2, pkts2, bytes2 =
            line:match(
                "src=(%S+)%s+dst=(%S+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)"
                .. "%s+src=(%S+)%s+dst=(%S+)%s+sport=(%d+)%s+dport=(%d+)%s+packets=(%d+)%s+bytes=(%d+)"
            )

        if not src1 then return nil end

        conn.src   = src1;   conn.dst   = dst1
        conn.sport = sport1; conn.dport = dport1
        conn.in_packets  = pkts1  or "0"
        conn.in_bytes    = bytes1 or "0"
        conn.out_packets = pkts2  or "0"
        conn.out_bytes   = bytes2 or "0"
    end

    if not conn.src then return nil end

    -- Extract conntrack mark
    local mark_str = line:match("%smark=(%d+)")
    local mark = tonumber(mark_str) or 0

    -- Decode DSCP: mark & 0x3F (lower 6 bits)
    -- marktrack encodes: mark = dscp | 128 (bit 7 = marktrack flag)
    local dscp_num = mark % 64  -- equivalent to mark & 0x3F
    conn.mark       = mark
    conn.dscp       = dscp_num
    conn.dscp_label = dscp_to_label(dscp_num)

    -- Normalise counters to numbers (avoids string concatenation bugs in the UI)
    conn.in_bytes    = tonumber(conn.in_bytes)    or 0
    conn.out_bytes   = tonumber(conn.out_bytes)   or 0
    conn.in_packets  = tonumber(conn.in_packets)  or 0
    conn.out_packets = tonumber(conn.out_packets) or 0

    -- Total bytes/packets (both directions)
    conn.bytes   = conn.in_bytes   + conn.out_bytes
    conn.packets = conn.in_packets + conn.out_packets
    conn.timeout = tonumber(conn.timeout) or 0

    return conn
end

-- Read MAX_CONNECTIONS from UCI
local function get_max_connections()
    local f = io.popen("uci -q get marktrack.settings.MAX_CONNECTIONS 2>/dev/null")
    if not f then return 0 end
    local val = tonumber(f:read("*l")) or 0
    f:close()
    return val
end

-- Main: read conntrack table and return a structured Lua table
local function get_conntrack_dscp()
    local connections = {}
    local count = 0
    local max_connections = get_max_connections()

    local f = io.open("/proc/net/nf_conntrack", "r")
    if not f then
        return { connections = {}, max_connections = 0, error = "Cannot open /proc/net/nf_conntrack" }
    end

    for line in f:lines() do
        if max_connections > 0 and count >= max_connections then break end

        local conn = parse_connection(line)
        if conn then
            -- Build a stable key for this connection
            local key = string.format("%s_%s_%s_%s_%s",
                conn.protocol, conn.src, conn.sport, conn.dst, conn.dport)

            connections[key] = {
                layer3      = conn.layer3,
                protocol    = conn.protocol,
                src         = conn.src,
                dst         = conn.dst,
                sport       = conn.sport,
                dport       = conn.dport,
                bytes       = conn.bytes,
                packets     = conn.packets,
                in_bytes    = conn.in_bytes,
                out_bytes   = conn.out_bytes,
                in_packets  = conn.in_packets,
                out_packets = conn.out_packets,
                timeout     = conn.timeout,
                mark        = conn.mark,
                dscp        = conn.dscp,
                dscp_label  = conn.dscp_label
            }
            count = count + 1
        end
    end
    f:close()

    return {
        connections     = connections,
        max_connections = max_connections
    }
end

-- ── rpcd exec-plugin dispatch ───────────────────────────────────────────────

local methods = {
    getConntrackDSCP = {
        call = function()
            return get_conntrack_dscp()
        end
    }
}

local action = arg[1]
local method = arg[2]

if action == "list" then
    -- Describe available methods (empty argument objects — none take params)
    local descr = {}
    for name, _ in pairs(methods) do
        descr[name] = {}
    end
    io.write(jsonc.stringify(descr) .. "\n")
elseif action == "call" and method and methods[method] then
    -- Read request parameters from stdin (may be empty)
    local input = io.read("*a") or ""
    local params = jsonc.parse(input) or {}
    local result = methods[method].call(params)
    io.write(jsonc.stringify(result) .. "\n")
else
    io.write(jsonc.stringify({ error = "unknown method" }) .. "\n")
end
