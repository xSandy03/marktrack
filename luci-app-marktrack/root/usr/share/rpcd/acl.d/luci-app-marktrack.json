{
  "luci-app-marktrack": {
    "description": "Grant access to Mark and Track LuCI app",
    "read": {
      "ubus": {
        "luci.marktrack": [ "getConntrackDSCP" ],
        "luci.marktrack_stats": [ "getRuleCounters" ]
      },
      "uci": [ "marktrack" ],
      "file": {
        "/etc/marktrack.d/custom_rules.nft": [ "read" ],
        "/tmp/marktrack_custom_rules_validation.txt": [ "read" ],
        "/proc/net/nf_conntrack": [ "read" ]
      }
    },
    "write": {
      "uci": [ "marktrack" ],
      "file": {
        "/etc/marktrack.d/custom_rules.nft": [ "write" ],
        "/etc/init.d/marktrack": [ "exec" ]
      },
      "ubus": {
        "luci": [ "setInitAction" ]
      }
    }
  }
}
